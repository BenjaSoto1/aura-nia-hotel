# URL pública. En Netlify puedes dejarla vacía: se usa la variable URL del sitio.
APP_PUBLIC_URL=http://localhost:3000
# Local: SQLite. En Netlify: Postgres (Netlify DB crea NETLIFY_DATABASE_URL sola, o pega aquí la URL de Neon).
DATABASE_URL=file:./dev.db

# Agente: ai | guided  (sin ANTHROPIC_API_KEY pasa solo a guided)
AGENT_MODE=ai
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Stripe (modo prueba). Vacío = pago simulado
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google (OAuth). Vacío = calendario y Gmail simulados
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: por defecto <APP_PUBLIC_URL>/api/google/callback
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=primary
CALENDAR_INVITE_GUEST=false
# Opcional: refresh token ya emitido (evita pasar por /api/google/auth en cada entorno)
GOOGLE_REFRESH_TOKEN=

# Correo: gmail | smtp | simulated
#  - gmail: usa la cuenta Google autorizada (si no está autorizada pero hay SMTP, usa SMTP)
#  - smtp:  Gmail con contraseña de aplicación (lo más simple para probar en Netlify)
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=Aura · Hotel Boutique & Casa de Mar
# Correo de la cuenta Google conectada (para mostrar "Aura <correo>" como remitente con la API de Gmail)
GMAIL_SENDER=
SMTP_USER=
SMTP_APP_PASSWORD=
# Opcional: otro proveedor SMTP (por defecto Gmail). SMTP_PORT 465 = TLS, 587 = STARTTLS
SMTP_HOST=
SMTP_PORT=
# Opcional: dirección "From" distinta de SMTP_USER (debe estar permitida por el proveedor)
EMAIL_FROM=

# Voz (web y teléfono): elevenlabs | browser  (sin ELEVENLABS_AGENT_ID = browser)
VOICE_PROVIDER=elevenlabs
ELEVENLABS_AGENT_ID=
# Solo si el agente es privado (autenticación activada): se pide un token de conversación
ELEVENLABS_API_KEY=

# Canales opcionales
WHATSAPP_PROVIDER=simulated

# Recordatorios
ENABLE_TIME_TRAVEL=true
# Opcional: protege /api/cron/reminders (lo usa la función programada de Netlify)
CRON_SECRET=

# Panel de administración (/panel): con valor, pide contraseña. Vacío = abierto (solo para desarrollo local).
ADMIN_PASSWORD=

# --- Instagram real (Meta). Sin token, Instagram queda simulado. Diagnóstico: npx tsx --env-file=.env scripts/instagram-setup.ts
# Token de Instagram Login (IGAA…, recomendado) o de Facebook Login (EAA…, de la página vinculada).
INSTAGRAM_ACCESS_TOKEN=
# App secret de Instagram (valida la firma de los webhooks). Obligatorio en producción.
INSTAGRAM_APP_SECRET=
# Texto que inventas y pegas también en Meta al configurar el webhook.
INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_PROVIDER=simulated   fuerza el simulador aunque haya token
