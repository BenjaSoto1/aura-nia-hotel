# Copia este archivo como .env:  cp .env.example .env
# Todo lo que quede vacío pasa solo a modo simulado: la app funciona igual sin ninguna clave.

APP_PUBLIC_URL=http://localhost:3000
# Base SQLite incluida en el repo (hotel cargado, sin reservas). Ruta relativa a la carpeta prisma/.
DATABASE_URL=file:./aura.db

# Agente de texto: ai | guided  (sin ANTHROPIC_API_KEY funciona en modo guiado con botones)
AGENT_MODE=ai
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Voz (web y teléfono) con el agente público de Nía en ElevenLabs. Sin ELEVENLABS_AGENT_ID usa la voz del navegador.
VOICE_PROVIDER=elevenlabs
ELEVENLABS_AGENT_ID=agent_8401m479rz1he7ar8jerhdnaw26r
# Solo para actualizar el agente con scripts/elevenlabs-agent.ts (no hace falta para usar la voz)
ELEVENLABS_API_KEY=

# Correo: smtp | gmail | simulated
#  - smtp: Gmail con contraseña de aplicación (myaccount.google.com/apppasswords). Llega a cualquier correo.
#  - gmail: API de Gmail con la cuenta Google autorizada en /api/google/auth
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=Aura · Hotel Boutique & Casa de Mar
SMTP_USER=
SMTP_APP_PASSWORD=
# Opcional: otro proveedor SMTP (por defecto Gmail). SMTP_PORT 465 = TLS, 587 = STARTTLS
SMTP_HOST=
SMTP_PORT=
# Opcional: dirección "From" distinta de SMTP_USER (debe estar permitida por el proveedor)
EMAIL_FROM=

# Stripe (modo prueba). Vacío = pago simulado
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Calendar del hotel (opcional; el huésped ya recibe la invitación .ics en el correo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=primary
CALENDAR_INVITE_GUEST=false
GMAIL_SENDER=
GOOGLE_REFRESH_TOKEN=

WHATSAPP_PROVIDER=simulated

# Recordatorios: con `npm start` corren solos cada minuto. ⏩ viaje en el tiempo para demos:
ENABLE_TIME_TRAVEL=true
# Opcional: protege /api/cron/reminders si lo llamas desde un cron externo
CRON_SECRET=
