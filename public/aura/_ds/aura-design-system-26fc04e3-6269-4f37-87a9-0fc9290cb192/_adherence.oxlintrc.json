{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/booking/**",
              "components/email/**",
              "components/hotel/**",
              "components/nia/**",
              "ui_kits/aura-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|DM Sans))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, DM Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookingBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:fields|cta|key|ref|className|style|children)$/]",
        "message": "<BookingBar> doesn't accept that prop. Declared props: fields, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookingForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|room|summary|total|deposit|onSubmit|key|ref|className|style|children)$/]",
        "message": "<BookingForm> doesn't accept that prop. Declared props: title, room, summary, total, deposit, onSubmit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|link|accent)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'link' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmationEmail'] > JSXAttribute > JSXIdentifier[name!=/^(?:guest|code|room|arrival|departure|guests|experience|experienceMeta|total|deposit|balance|key|ref|className|style|children)$/]",
        "message": "<ConfirmationEmail> doesn't accept that prop. Declared props: guest, code, room, arrival, departure, guests, experience, experienceMeta, total, deposit, balance."
      },
      {
        "selector": "JSXOpeningElement[name.name='NiaAvatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|dot|style|key|ref|className|style|children)$/]",
        "message": "<NiaAvatar> doesn't accept that prop. Declared props: size, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoomCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|description|amenities|occupancy|gradient|imageLabel|key|ref|className|style|children)$/]",
        "message": "<RoomCard> doesn't accept that prop. Declared props: name, size, description, amenities, occupancy, gradient, imageLabel."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "BookingBar": {
        "replaces": []
      },
      "BookingForm": {
        "replaces": []
